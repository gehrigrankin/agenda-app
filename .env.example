# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ----------------------------------------------
# Use the *pooled* connection string from the Neon dashboard for the app, and
# the same (or direct) string for drizzle-kit migrations.
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:password@your-neon-host.neon.tech/agenda?sslmode=require"

# --- Auth (Clerk) ----------------------------------------------------------
# From the Clerk dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where Clerk should send users for auth. These match the routes scaffolded
# under src/app/(auth). Override only if you change those routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/app"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/app"

# --- File storage ----------------------------------------------------------
# The storage layer (src/lib/storage) supports three drivers:
#   local — dev stub, writes to public/uploads (ephemeral on serverless hosts)
#   db    — bytes in Postgres, served via /api/uploads (default when
#           DATABASE_URL is set and STORAGE_DRIVER is unset; personal-scale)
#   s3    — production path: set STORAGE_DRIVER=s3 and fill the S3_* vars.
STORAGE_DRIVER="local"
# Required for STORAGE_DRIVER=s3. Returned image URLs point straight at the
# bucket, so the bucket/prefix must be publicly readable (or front it with a
# CDN via S3_PUBLIC_BASE_URL below).
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Optional: base URL for returned object URLs, e.g. a CloudFront/R2 public
# domain ("https://cdn.example.com" — the object key is appended).
# S3_PUBLIC_BASE_URL=""
# Optional: custom endpoint for S3-compatible stores (R2, MinIO, ...);
# switches the client to path-style addressing.
# S3_ENDPOINT=""

# --- AI (Anthropic) ----------------------------------------------------------
# Powers ask-your-notes (⌘K questions), voice-memo extraction, thread
# detection, the week-in-review draft, and automations. Everything degrades
# gracefully when unset: those features simply report "not configured".
# Ambient recall and meeting mode do NOT need this key (no model calls).
# ANTHROPIC_API_KEY="sk-ant-..."
# Model for all AI features. Defaults to claude-haiku-4-5 (cheapest tier —
# realistic usage lands well under $1/month). Set to claude-opus-4-8 for the
# highest answer quality at ~5x the token price.
# AI_MODEL="claude-haiku-4-5"

# --- Maintenance -------------------------------------------------------------
# Shared secret for the on-demand migration route (/api/db/migrate). The route
# is disabled (404) unless this is set; requests must send it via the
# `x-migrate-key` header or `?key=` param. Generate with: openssl rand -hex 32
# MIGRATE_SECRET=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Web push (task reminders) ---------------------------------------------
# Real iPhone/desktop notifications for task + habit reminders. Generate a key
# pair with: npx web-push generate-vapid-keys
# The public key ships to the browser (NEXT_PUBLIC_); the private key signs
# pushes server-side. VAPID_SUBJECT is a contact URI the push services may use
# to reach you (mailto: your email). ALL THREE must also be set in the Vercel
# project env for production pushes to work. Everything degrades gracefully
# when unset: the settings row shows "not configured" and sends no-op.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"

# Shared secret protecting the reminder cron route (/api/cron/reminders).
# Vercel sets `Authorization: Bearer $CRON_SECRET` on its cron requests when
# this env var exists in the project (Vercel convention — add it there too).
# Locally you can trigger the route by hand: GET /api/cron/reminders?secret=…
# Generate with: openssl rand -hex 32
# CRON_SECRET=""

# ---------------------------------------------------------------------------
# Machine-facing API (POST /api/mcp — the MCP server — and POST /api/tasks).
# Lets an assistant read and write notes, tasks, tags and daily jots without a
# browser session. BOTH vars are required and the API fails closed without
# them: unset token -> 503, unset owner -> 503 rather than guessing whose data
# to touch. The owner id is your Clerk user id (the `ownerId` on your rows).
# Generate the token with: openssl rand -hex 32
# NOTARIUM_API_TOKEN=""
# NOTARIUM_API_OWNER_ID="user_..."

# --- Query logging (slow-query hunting) --------------------------------------
# Logs one compact line per database round trip with its wall-clock duration,
# so slow statements are greppable: `grep '\[db\]'`, `grep SLOW`.
#   off  — no logging (DEFAULT in production and any non-development build)
#   slow — only statements at/over DB_LOG_SLOW_MS, plus failures
#   all  — every statement (DEFAULT when NODE_ENV=development)
# DB_LOG="all"
# Threshold in ms for the SLOW marker (and for what `DB_LOG=slow` prints).
# Defaults to 300.
# DB_LOG_SLOW_MS="300"
# Param VALUES are user note/task content, so they are redacted by default and
# only the param count is logged. Set to 1 to log values too — local debugging
# only, never in a deployed environment.
# DB_LOG_PARAMS="0"
